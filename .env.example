# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Base URL of the ai-nonymauz-cloud API (used starting Phase 2)
AI_NONYMAUZ_CLOUD_URL=https://your-ai-nonymauz-cloud-url

# Optional shared secret sent with requests to ai-nonymauz-cloud
AI_NONYMAUZ_CLOUD_API_KEY=

# Optional: RapidAPI key for the JSearch jobs API. When set, /jobs and job
# watches return real structured listings instead of the cloud web search.
# Get a free key at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=

# --- Webhook mode (deployment only; leave unset for local long polling) ---
# Public HTTPS URL of this bot. On Render this is auto-provided as
# RENDER_EXTERNAL_URL, so you usually don't need to set WEBHOOK_URL yourself.
WEBHOOK_URL=
# Optional random string; Telegram echoes it back so you can verify requests.
WEBHOOK_SECRET_TOKEN=
# Shared secret guarding the /tasks/run-job-watches endpoint. Must match the
# CRON_SECRET stored in the GitHub Actions job-watch workflow secrets.
CRON_SECRET=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
